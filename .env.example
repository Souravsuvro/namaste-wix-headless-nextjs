# ============================================================
# Namaste Gien — Wix Headless Next.js Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local — it is gitignored
# ============================================================

# Wix Headless Configuration
WIX_CLIENT_ID=your_wix_oauth_client_id_here
WIX_API_KEY=your_wix_api_key_here
WIX_SITE_ID=your_wix_site_id_here
WIX_ACCOUNT_ID=your_wix_account_id_here

# Wix Bookings (Reservations)
WIX_BOOKINGS_SERVICE_ID=your_service_id_here

# Next.js Auth
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=https://www.namastegien.fr
NEXT_PUBLIC_BASE_URL=https://www.namastegien.fr

# Restaurant Info (public — safe to use in frontend)
NEXT_PUBLIC_RESTAURANT_NAME=Namaste Gien
NEXT_PUBLIC_RESTAURANT_PHONE=+33751517109
NEXT_PUBLIC_RESTAURANT_EMAIL=contact@namastegien.fr
NEXT_PUBLIC_RESTAURANT_STREET=2 Pl. du Maréchal Foch
NEXT_PUBLIC_RESTAURANT_CITY=Gien
NEXT_PUBLIC_RESTAURANT_POSTCODE=45500
NEXT_PUBLIC_RESTAURANT_COUNTRY=FR
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.google.com/?q=2+Pl.+du+Maréchal+Foch,+45500+Gien,+France

# Analytics
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Node
NODE_ENV=development
